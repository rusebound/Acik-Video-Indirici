{
  "manifest_version": 3,
  "name": "Açık Video İndirici",
  "short_name": "Video İndirici",
  "version": "2.2.1",
  "description": "İzinli YouTube videoları için MKV/MP4/WebM ve MP3/M4A/Opus/WAV/FLAC; diğer sitelerde doğrudan ses/video algılama.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sayfadaki video kaynakları",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "webRequest",
    "storage",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
